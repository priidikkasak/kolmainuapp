# Postgres (Neon, Supabase, Vercel Postgres — any Postgres works)
DATABASE_URL=

# Session signing key — openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob token, needed for image uploads in the admin
BLOB_READ_WRITE_TOKEN=

# Tenant used when the host does not map to one (localhost, previews)
DEFAULT_TENANT=kolmainu

# Only read by `npm run db:seed` when creating the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
